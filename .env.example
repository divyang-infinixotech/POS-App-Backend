[TEMPLATE]
# ─── Backend environment template ───
# Copy to .env and fill in real values. .env is git-ignored — never commit it.

# REQUIRED — the server refuses to start without these:
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/restaurant_pos
JWT_SECRET=change-me-to-a-long-random-string

# Optional (sensible defaults exist):
BACKEND_PORT=5001
NODE_ENV=development
JWT_EXPIRES_IN=7d

# Comma-separated browser origins allowed to call the API + Socket.IO.
# REQUIRED in production — e.g. https://pos.yourdomain.com
ALLOWED_ORIGINS=

# Image storage: local (default) or cloudinary
STORAGE_DRIVER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Razorpay (subscription upgrade/renewal payments) ───
# Required only for online subscription purchases. Without these the checkout
# endpoint returns 503 "Payment gateway is not configured" — the rest of the
# app keeps working. The backend boots fine without them and logs a one-line
# readiness check at startup (never prints secret values).
#
# Where to get these:
#   1. Create an account at https://dashboard.razorpay.com
#   2. API Keys → Generate Key (Key ID + Key Secret)
#   3. Use TEST/development mode keys during development — never production
#      (LIVE) keys in a dev environment.
#   4. Settings → Webhooks → Add Webhook → point at
#      https://<your-backend>/api/subscriptions/webhook with the events
#      payment.captured / payment.failed, and copy the generated Webhook
#      Secret below (it must match the dashboard value exactly).
#   5. Switch to LIVE keys only in production, and re-point the webhook URL
#      to the production backend.
#
# IMPORTANT: never commit the real .env file (it is git-ignored). Only this
# .env.example template with empty placeholders belongs in the repository.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# ─── Frontend URL (email links) ───────────────────────────────────────────
# Public base URL of the frontend app — used for EVERY email login/verification
# link. This is the single configuration point for email link URLs.
#   Development: http://localhost:3000
#   Production:  https://app.yourdomain.com   ← REQUIRED (never localhost)
# In production a missing APP_FRONTEND_URL means email link generation FAILS
# LOUDLY (logged, email not queued) instead of silently mailing localhost links.
APP_FRONTEND_URL=http://localhost:3000

# ─── Email: ACTIVE PROVIDER SELECTION ────────────────────────────────────
# Which transport delivers platform email: Microsoft Graph or SMTP/Gmail.
# Allowed values: GRAPH | SMTP (anything else fails validation).
#   GRAPH → Microsoft Graph (recommended for production; see block below)
#   SMTP  → Nodemailer SMTP (Gmail works with an App Password; see block below)
#
# Precedence: the Super Admin's saved selection (Super Admin → System Settings
# → Email Configuration, stored in the database) ALWAYS wins over this env var.
# This env var is the default/fallback for fresh deployments and legacy setups;
# the historical MICROSOFT_GRAPH_ENABLED=true flag still maps to GRAPH.
# The selected provider NEVER silently falls back to the other one on failure —
# provider selection and provider failure are deterministic.
EMAIL_PROVIDER=SMTP

# ─── Email transport: Microsoft Graph (production) ──────────────────────────
# Auth: OAuth 2.0 client credentials (app-only) — see docs/microsoft-graph-email.md
# for the full Entra ID setup checklist (app registration, Mail.Send app
# permission, admin consent, sender mailbox).
MICROSOFT_GRAPH_TENANT_ID=
MICROSOFT_GRAPH_CLIENT_ID=
MICROSOFT_GRAPH_CLIENT_SECRET=
# The M365 mailbox the app sends FROM (must exist in Exchange Online):
MICROSOFT_GRAPH_SENDER_EMAIL=
# Legacy flag (kept for compatibility): true → Graph is the default transport
# when no Super Admin selection / EMAIL_PROVIDER exists. The Super Admin's
# saved provider selection in the database always takes precedence.
MICROSOFT_GRAPH_ENABLED=false
# Manual test script recipient (scripts/test-microsoft-graph-email.js only):
MICROSOFT_GRAPH_TEST_RECIPIENT=

# ─── Email transport: SMTP / Gmail (legacy, still fully supported) ──────────
# Used when the active provider is SMTP. SMTP settings saved by the Super Admin
# (Super Admin → System Settings → Email Configuration) take precedence over
# these env vars at runtime. NEVER put real credentials in this file — they
# belong in the git-ignored .env.
# Gmail: host smtp.gmail.com, port 587 (STARTTLS) or 465 (SSL), username is the
# Gmail address, password is a 16-character App Password (Google Account →
# Security → 2-Step Verification → App passwords) — never the account password.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_NAME=
MAIL_FROM_EMAIL=
MAIL_REPLY_TO=

# Comma-separated recipient list that receives new-application notifications.
# Falls back to all active SUPER_ADMIN users when unset.
SUPER_ADMIN_NOTIFICATION_EMAIL=
