# ─── Backend environment template ───
# Copy to .env and fill in real values. .env is git-ignored — never commit it.

# REQUIRED — the server refuses to start without these:
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/restaurant_pos
JWT_SECRET=change-me-to-a-long-random-string

# Optional (sensible defaults exist):
BACKEND_PORT=5001
NODE_ENV=development
JWT_EXPIRES_IN=7d

# Comma-separated browser origins allowed to call the API + Socket.IO.
# REQUIRED in production — e.g. https://pos.yourdomain.com
ALLOWED_ORIGINS=

# Image storage: local (default) or cloudinary
STORAGE_DRIVER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Razorpay (subscription upgrade/renewal payments) ───
# Required only for online subscription purchases. Without these the checkout
# endpoint returns 503 "Payment gateway is not configured" — the rest of the
# app keeps working. The backend boots fine without them and logs a one-line
# readiness check at startup (never prints secret values).
#
# Where to get these:
#   1. Create an account at https://dashboard.razorpay.com
#   2. API Keys → Generate Key (Key ID + Key Secret)
#   3. Use TEST/development mode keys during development — never production
#      (LIVE) keys in a dev environment.
#   4. Settings → Webhooks → Add Webhook → point at
#      https://<your-backend>/api/subscriptions/webhook with the events
#      payment.captured / payment.failed, and copy the generated Webhook
#      Secret below (it must match the dashboard value exactly).
#   5. Switch to LIVE keys only in production, and re-point the webhook URL
#      to the production backend.
#
# IMPORTANT: never commit the real .env file (it is git-ignored). Only this
# .env.example template with empty placeholders belongs in the repository.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
