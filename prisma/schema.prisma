generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ──────────────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  MANAGER
  CASHIER
  WAITER
  KITCHEN
  SUPER_ADMIN
}

/// Per-staff dietary access (Parts 9/10 — enforced server-side on menu + orders).
enum DietaryAccess {
  VEG_ONLY
  VEG_AND_NON_VEG
}

/// Restaurant-level MAXIMUM dietary mode (Part 4/5). The restaurant is the
/// upper boundary: a VEG_ONLY restaurant can never expose NON_VEG, regardless
/// of any staff member's individual dietaryAccess.
enum DietaryMode {
  VEG_ONLY
  VEG_AND_NON_VEG
}

/// Explicit dietary type on menu items. Extends (does not replace) isVeg.
enum DietaryType {
  VEG
  NON_VEG
}

enum RestaurantStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

/// Billing cycle for a subscription plan
enum BillingCycle {
  MONTHLY
  YEARLY
  ONCE
}

/// Type of subscription change recorded in plan history (append-only)
enum PlanChangeType {
  CREATION
  UPGRADE
  DOWNGRADE
  SWITCH
  RENEWAL
  SUSPENSION
  REACTIVATION
  CANCELLATION
  EXPIRATION
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  CLEANING
}

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
  COUNTER_SALE
}

enum OrderStatus {
  PENDING
  PREPARING
  READY
  SERVED
  COMPLETED
  CANCELLED
  HOLD
}

enum DiscountType {
  FLAT
  PERCENTAGE
}

enum KOTStatus {
  PENDING
  PREPARING
  READY
  SERVED
  ACCEPTED
  CANCELLED
}

enum BillStatus {
  UNPAID
  PAID
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  UPI
}

enum PaymentStatus {
  PENDING
  PAID
  PARTIAL
  REFUNDED
  FAILED
}

enum PaymentGateway {
  RAZORPAY
  CASHFREE
  PHONEPE
  PAYTM
  STRIPE
  NONE
}

enum AuditModule {
  AUTH
  USER
  CATEGORY
  MENU
  TABLE
  ORDER
  KOT
  BILL
  PAYMENT
  SETTINGS
  PRINTER
  DASHBOARD
  SUBSCRIPTION
  CUSTOMER
  FLOOR
  REPORT
  NOTIFICATION
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  PRINT
  REPRINT
  CANCEL
  PAYMENT
  VIEW
  REFUND
  APPLY_DISCOUNT
}

enum CustomerType {
  WALK_IN
  REGULAR
  VIP
}

enum ConnectionType {
  USB
  LAN
  BLUETOOTH
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  TRIAL
  SUSPENDED
  /// Subscription row created during self-serve onboarding (plan chosen, payment not yet verified)
  PENDING_PAYMENT
}

/// Verification status for uploaded business documents
enum DocumentStatus {
  PENDING
  UNDER_REVIEW
  VERIFIED
  REJECTED
}

/// Onboarding lifecycle status (separate from restaurant ACTIVE/INACTIVE).
/// Legacy SUPER_ADMIN values (DRAFT / PENDING_DOCUMENT_REVIEW / ACTIVE / REJECTED)
/// are preserved; the remaining values track the self-serve registration flow.
enum OnboardingStatus {
  DRAFT
  PENDING_DOCUMENT_REVIEW
  ACTIVE
  REJECTED
  /// Account registered — business details not submitted yet
  REGISTERED
  /// Business details step in progress / submitted
  ONBOARDING
  /// Business details complete, waiting on document uploads
  DOCUMENTS_PENDING
  /// At least one document uploaded, waiting on legal acceptance
  LEGAL_PENDING
  /// Legal agreements accepted, awaiting plan selection
  PLAN_PENDING
  /// Legal agreements accepted, plan chosen (payment not started)
  PLAN_SELECTED
  /// Plan chosen, checkout created but payment not yet verified
  PAYMENT_PENDING
  /// Payment verified by the backend (awaiting provisioning or manual review)
  PAYMENT_SUCCESS
  /// Payment verified — application queued for SUPER_ADMIN document review
  UNDER_REVIEW
  /// Tenant schema provisioning in progress
  PROVISIONING
  /// Payment attempt failed
  PAYMENT_FAILED
  /// A required document was rejected and not yet replaced
  DOCUMENT_REJECTED
  /// Onboarding account suspended (no POS access)
  SUSPENDED
  /// Onboarding application expired
  EXPIRED
  /// Manual-review flow: application submitted, awaiting SUPER_ADMIN review
  MANUAL_PENDING
  /// Manual-review flow: payment QR shown, awaiting payment
  MANUAL_PAYMENT_PENDING
  /// Manual-review flow: payment verified by SUPER_ADMIN, awaiting approval
  MANUAL_PAYMENT_RECEIVED
  /// Manual-review flow: approved and activated
  MANUAL_APPROVED
  /// Manual-review flow: rejected
  MANUAL_REJECTED
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
  ORDER
  KITCHEN
  PAYMENT
  SUBSCRIPTION
  SYSTEM
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum BusinessType {
  RESTAURANT
  CAFE
  BAR
  FOOD_TRUCK
  CLOUD_KITCHEN
  OTHER
  BAKERY
  HOTEL
  FOOD_COURT
  /// Retail verticals (additive — legacy records unaffected)
  SUPERMARKET
  GROCERY
  CLOTHING
}

/// High-level POS experience determined by the subscription plan.
/// BASIC_POS: quick billing, no tables/KOT/kitchen workflow
/// RESTAURANT: full dine-in with tables, KOT, kitchen, active orders
enum BusinessMode {
  BASIC_POS
  RESTAURANT
}

// ─── Models ─────────────────────────────────────────────────────────────────────

/// Multi-tenant SaaS: User belongs to a Restaurant. SUPER_ADMIN has no restaurantId.
model User {
  id                Int       @id @default(autoincrement())
  name              String
  email             String    @unique // Login identifier — globally unique
  password          String
  role              UserRole
  isActive          Boolean   @default(true)
  avatar            String?
  phone             String? // Per-restaurant uniqueness via app logic (SUPER_ADMIN has no restaurantId)
  lastLogin         DateTime?
  passwordChangedAt DateTime?
  /// True while the account still uses an emailed temporary password —
  /// first login must force a password change (temporary credentials are
  /// never valid beyond the first change).
  mustChangePassword Boolean @default(false)
  deletedAt         DateTime?
  restaurantId      Int?
  // Per-staff dietary access (tenant staff only; ADMIN defaults to VEG_AND_NON_VEG)
  dietaryAccess     DietaryAccess @default(VEG_AND_NON_VEG)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  restaurant    Restaurant?    @relation(fields: [restaurantId], references: [id])
  auditLogs     AuditLog[]
  notifications Notification[]
  permissions   UserPermission[]
  floorAssignments UserFloorAssignment[]

  // Tickets created by this user
  supportTickets SupportTicket[]

  // Tickets assigned to this user
  assignedTickets SupportTicket[] @relation("AssignedTickets")

  // Documents uploaded by this user
  uploadedDocuments RestaurantDocument[]

  // Documents verified by this user
  verifiedDocuments RestaurantDocument[] @relation("VerifiedDocuments")

  // Policy agreements accepted by this user
  policyAccepted PolicyAgreement[] @relation("PolicyAccepters")

  // Orders this user placed (tenant Order.userId — staff attribution; the
  // relation is cross-schema by convention, resolved per-restaurant at runtime)
  placedOrders Order[] @relation("OrderPlacedBy")

  @@index([restaurantId])
  @@index([isActive])
  @@index([email])
  @@index([role])
}

/// Top-level tenant. Every business table references this model.
model Restaurant {
  id               Int              @id @default(autoincrement())
  name             String
  ownerName        String
  phone            String           @unique
  email            String?          @unique
  gstNumber        String?
  fssaiNumber      String?
  address          String?
  city             String?
  state            String?
  country          String?
  pincode          String?
  logo             String?
  website          String?
  supportEmail     String?
  supportPhone     String?
  businessType     BusinessType     @default(RESTAURANT)
  timezone         String           @default("Asia/Kolkata")
  currency         String           @default("INR")
  language         String           @default("en")
  tenantSchema     String?          @unique // PostgreSQL schema name (e.g. "restaurant_1") — generated by backend, never user-supplied
  subscriptionPlan String           @default("TRIAL") // plan code (denormalized from Plan.code)
  /// Legal / registered business name (distinct from the trading name)
  legalName          String?
  /// Business / company registration number (where applicable)
  registrationNumber String?
  /// True when the restaurant was created through the public self-serve onboarding flow
  selfServe          Boolean           @default(false)
  /// SUPER_ADMIN note on the application (approval note or rejection reason)
  onboardingNote     String?
  status           RestaurantStatus @default(ACTIVE)
  deletedAt        DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  users                User[]
  categories           Category[]
  subcategories        Subcategory[]
  menuItems            MenuItem[]
  customers            Customer[]
  tables               RestaurantTable[]
  floors               Floor[]
  orders               Order[]
  kots                 KOT[]
  bills                Bill[]
  payments             Payment[]
  notifications        Notification[]
  auditLogs            AuditLog[]
  printerSetting       PrinterSetting?
  restaurantSetting    RestaurantSetting?
  subscription         Subscription?
  subscriptionHistory  SubscriptionHistory[]
  subscriptionPayments SubscriptionPayment[]
  supportTickets       SupportTicket[]
  stockMovements       StockMovement[]
  documents            RestaurantDocument[]
  policyAgreements     PolicyAgreement[]
  onboardingStatus     OnboardingStatus?     @default(DRAFT)
  /// Self-serve application expiry — set when the application is submitted for
  /// review; the expiry cron flips stale applications to EXPIRED exactly once.
  applicationExpiresAt    DateTime?
  /// Set when the expiry notification email was sent — idempotency flag so a
  /// repeated cron run never re-sends the expiration email.
  expiredNotificationSentAt DateTime?
  mergeGroups          MergeGroup[]
}

/// Per-restaurant settings (1:1 with Restaurant)
model RestaurantSetting {
  id                      Int      @id @default(autoincrement())
  restaurantName          String
  gstNumber               String?
  phone                   String?
  email                   String?
  address                 String?
  logo                    String?
  fssaiNumber             String?
  website                 String?
  currency                String   @default("INR")
  timezone                String   @default("Asia/Kolkata")
  language                String   @default("en")
  billNumberStart         Int      @default(1)
  billPrefix              String   @default("BILL")
  invoicePrefix           String   @default("INV")
  kotPrefix               String   @default("KOT")
  receiptFooter           String?  @default("Thank You! Visit Again.")
  roundOffEnabled         Boolean  @default(true)
  serviceCharge           Float    @default(0)
  taxPercentage           Float    @default(0)
  enableKitchenDisplay    Boolean  @default(false)
  enableKotStatusTracking Boolean  @default(false)
  upiId                   String?  @default("")
  // ── Module Visibility Settings ──
  enableKitchen           Boolean  @default(true)
  enableBilling           Boolean  @default(true)
  enableHoldOrders        Boolean  @default(true)
  enableAddItem           Boolean  @default(true)
  enableSplitBill         Boolean  @default(true)
  enableTransferTable     Boolean  @default(true)
  enableMergeTables       Boolean  @default(true)
  enableFloorManagement   Boolean  @default(true)
  enableReports           Boolean  @default(true)
  enableMenu              Boolean  @default(true)
  enableStock             Boolean  @default(true)
  enableActiveOrders      Boolean  @default(true)
  enableTableReservations Boolean  @default(false)
  enableStaffRoster       Boolean  @default(true) // Staff Roster sidebar/route/API toggle (plan entitlement still applies first)
  // ── Billing Behavior Settings ──
  autoPrintBill           Boolean  @default(false)
  autoPrintKOT            Boolean  @default(false)
  autoGenerateKOT         Boolean  @default(false)
  multiplePayments        Boolean  @default(false)
  askCustomerBeforePrint  Boolean  @default(false)
  autoReleaseTable        Boolean  @default(true)
  // ── POS Ordering / Layout Settings (persisted per restaurant) ──
  dietaryMode             DietaryMode @default(VEG_AND_NON_VEG) // restaurant-level max dietary mode (upper boundary for staff access)
  enablePosOrdering       Boolean  @default(true) // POS Ordering screen — ALWAYS on (Part 10); column kept for schema stability, never set false
  // Part 11: Barcode Scanner tenant toggle. Plan entitlement (requireFeature
  // "barcode_scanner") is the upper limit; this flag is the restaurant's own
  // ON/OFF. Default false = safe default (scanner inactive until enabled).
  barcodeScannerEnabled   Boolean  @default(false)
  posLayout               String   @default("basic") // 'basic' | 'standard' | 'quick' — Basic POS layout
  businessMode            String   @default("restaurant") // 'restaurant' | 'counter' (Basic POS) | 'hybrid'
  enableCounterSale       Boolean  @default(false) // Basic POS quick-billing flow
  taxType                 String   @default("Inclusive") // Inclusive | Exclusive
  taxesAndCharges         Json? // Array of manually-created tax rules; no defaults are seeded
  uiSettings              Json? // Full frontend settings snapshot for fields without explicit columns
  restaurantId            Int      @unique
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])

  @@index([restaurantId])
}

/// Physical/virtual floor within a restaurant
model Floor {
  id           Int      @id @default(autoincrement())
  name         String
  floorCode    String?
  description  String?
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  restaurantId Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant        @relation(fields: [restaurantId], references: [id])
  tables     RestaurantTable[]
  staffAssignments UserFloorAssignment[]

  @@unique([restaurantId, name])
  @@index([restaurantId])
}

/// Dining table within a floor
model RestaurantTable {
  id           Int         @id @default(autoincrement())
  tableNo      String
  name         String?
  capacity     Int
  status       TableStatus @default(AVAILABLE)
  shape        String      @default("round")
  floorId      Int?
  restaurantId Int
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  floor      Floor?     @relation(fields: [floorId], references: [id])
  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  orders     Order[]
  mergeGroups MergeGroupTable[]

  @@unique([restaurantId, tableNo])
  @@index([restaurantId])
  @@index([floorId])
  @@index([status])
}

/// Menu category per restaurant
model Category {
  id           Int      @id @default(autoincrement())
  name         String
  image        String?
  color        String   @default("#16A34A")
  icon         String   @default("utensils")
  sortOrder    Int      @default(0)
  isActive     Boolean  @default(true)
  restaurantId Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  menuItems  MenuItem[]
  subcategories Subcategory[]

  @@unique([restaurantId, name])
  @@index([restaurantId])
  @@index([isActive])
}

/// Subcategory — optional hierarchy layer: Category → Subcategory → MenuItem.
/// Lives in every tenant schema. Subcategory is OPTIONAL for menu items
/// (subcategoryId = null keeps existing items working unchanged).
model Subcategory {
  id           Int      @id @default(autoincrement())
  name         String
  description  String?
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  categoryId   Int
  restaurantId Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  category  Category   @relation(fields: [categoryId], references: [id])
  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  menuItems MenuItem[]

  @@unique([restaurantId, categoryId, name])
  @@index([restaurantId])
  @@index([categoryId])
  @@index([isActive])
}

/// Per-staff permission overrides (tenant-scoped). Absent rows mean "use the
/// role default" — this is what lets existing staff keep their current access
/// after migration while still allowing per-user customization.
model UserPermission {
  id            Int      @id @default(autoincrement())
  userId        Int
  permissionKey String
  enabled       Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionKey])
  @@index([userId])
  @@index([permissionKey])
}

/// Staff-to-floor assignment (tenant-scoped, many-to-many).
/// A staff member may work on multiple floors and a floor may have multiple
/// staff members. Used to scope floor/table visibility for floor-restricted
/// staff; ADMIN stays restaurant-wide and is never filtered by assignments.
model UserFloorAssignment {
  id        Int      @id @default(autoincrement())
  userId    Int
  floorId   Int
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  floor Floor @relation(fields: [floorId], references: [id], onDelete: Cascade)

  @@unique([userId, floorId])
  @@index([userId])
  @@index([floorId])
}

/// Menu item / dish. SKU is unique per restaurant.
model MenuItem {
  id               Int      @id @default(autoincrement())
  name             String
  shortName        String?
  sku              String?
  barcode          String?
  description      String?
  shortDescription String?
  image            String? // imageUrl — only self-hosted / app-storage URLs (never arbitrary external URLs)
  imagePublicId    String? // storage reference (e.g. "menu/{restaurantId}/{uuid}.jpg" or Cloudinary public_id)
  imageIsExternal  Boolean  @default(false) // legacy marker: image points at a third-party URL awaiting user replacement
  images           Json     @default("[]")
  price            Float
  costPrice        Float?
  gstPercentage    Float    @default(0)
  taxInclusive     Boolean  @default(true)
  tax              Float    @default(0)
  preparationTime  Int      @default(15) // minutes
  kitchenCategory  String?  @default("")
  displayOrder     Int      @default(0)
  spicyLevel       Int      @default(0) // 0-5 scale
  isVeg            Boolean  @default(true) // legacy flag kept for backward compatibility (reports/printers)
  dietaryType      DietaryType @default(VEG) // authoritative dietary type (migrated from isVeg)
  isAvailable      Boolean  @default(true)
  isFeatured       Boolean  @default(false)
  isRecommended    Boolean  @default(false)
  currentStock     Int?
  minStock         Int      @default(10)
  maxStock         Int?
  modifierOptions  String? // JSON string storing modifier groups (e.g., "Extra Cheese: Mozzarella +30, Cheddar +40")
  unit             String   @default("piece")
  categoryId       Int
  restaurantId     Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  category       Category        @relation(fields: [categoryId], references: [id])
  subcategory    Subcategory?    @relation(fields: [subcategoryId], references: [id])
  subcategoryId  Int?
  restaurant     Restaurant      @relation(fields: [restaurantId], references: [id])
  orderItems     OrderItem[]
  stockMovements StockMovement[]
  kotItems       KOTItem[]

  @@unique([restaurantId, sku])
  @@index([restaurantId])
  @@index([categoryId])
  @@index([isAvailable])
  @@index([sku])
  @@index([barcode])
  @@index([isVeg])
}

/// Customer per restaurant. Phone is unique within each restaurant for loyalty.
model Customer {
  id           Int          @id @default(autoincrement())
  name         String
  phone        String?
  email        String?
  gstNumber    String?
  address      String?
  notes        String?
  birthday     DateTime?
  anniversary  DateTime?
  type         CustomerType @default(WALK_IN)
  totalOrders  Int          @default(0)
  totalSpent   Float        @default(0)
  restaurantId Int
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  orders     Order[]

  @@unique([restaurantId, phone])
  @@index([restaurantId])
  @@index([phone])
  @@index([email])
  @@index([type])
}

/// Order placed at a restaurant
model Order {
  id               Int           @id @default(autoincrement())
  orderNo          String
  orderType        OrderType
  status           OrderStatus   @default(PENDING)
  subtotal         Float         @default(0)
  taxAmount        Float         @default(0)
  totalAmount      Float         @default(0)
  discount         Float         @default(0)
  discountType     DiscountType?
  discountValue    Float         @default(0)
  serviceCharge    Float         @default(0)
  roundOff         Float         @default(0)
  notes            String?
  cancelReason     String?
  /// The authenticated user who placed the order (service staff / admin /
  /// cashier). Always derived from the JWT server-side — never client-supplied.
  userId           Int?
  tableId          Int?
  customerId       Int?
  isDeleted        Boolean       @default(false)
  deletedAt        DateTime?
  holdAt           DateTime?
  cancelledAt      DateTime?
  acceptedAt       DateTime?
  cookingStartedAt DateTime?
  readyAt          DateTime?
  servedAt         DateTime?
  completedAt      DateTime?
  /// When stock was deducted at order placement (idempotency guard — set exactly once when the order is created)
  stockDeductedAt  DateTime?
  /// When reserved stock was restored back to inventory (idempotency guard — set exactly once on cancel/delete)
  stockRestoredAt  DateTime?
  restaurantId     Int
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  bill           Bill?
  kot            KOT[]
  customer       Customer?        @relation(fields: [customerId], references: [id])
  restaurant     Restaurant       @relation(fields: [restaurantId], references: [id])
  table          RestaurantTable? @relation(fields: [tableId], references: [id])
  /// The user (public.User) who placed the order — service staff attribution.
  user           User?            @relation("OrderPlacedBy", fields: [userId], references: [id])
  orderItems     OrderItem[]
  stockMovements StockMovement[]
  mergeGroupsAsPrimary MergeGroup[]
  mergeGroupsAsOriginal MergeGroupTable[]

  @@unique([restaurantId, orderNo])
  @@index([restaurantId])
  @@index([status])
  @@index([tableId])
  @@index([customerId])
  @@index([createdAt])
  @@index([orderType])
}

/// Line items within an order
model OrderItem {
  id           Int      @id @default(autoincrement())
  quantity     Int
  /// Quantity already sent/printed to kitchen via KOT.
  /// KOT delta = quantity − sentQuantity.  For backward compatibility
  /// with orders created before this field existed, a NULL value is
  /// treated as "all sent" (sentQuantity = quantity).
  sentQuantity Int?     @default(0)
  price        Float
  tax          Float
  total        Float
  notes        String?
  orderId      Int
  menuItemId   Int
  createdAt    DateTime @default(now())

  menuItem MenuItem  @relation(fields: [menuItemId], references: [id])
  order    Order     @relation(fields: [orderId], references: [id])
  kotItems KOTItem[]

  @@index([orderId])
  @@index([menuItemId])
  @@index([orderId, menuItemId])
}

/// Append-only stock movement history (order deductions, adjustments, restores)
model StockMovement {
  id           Int      @id @default(autoincrement())
  restaurantId Int
  menuItemId   Int
  orderId      Int?
  type         String   @default("ORDER_CREATED") // ORDER_CREATED | ORDER_UPDATED | ORDER_CANCELLED | STOCK_ADJUSTMENT
  quantity     Int // signed: negative for deductions, positive for additions
  stockBefore  Int?
  stockAfter   Int?
  reference    String?
  createdBy    Int?
  createdAt    DateTime @default(now())

  menuItem   MenuItem   @relation(fields: [menuItemId], references: [id])
  order      Order?     @relation(fields: [orderId], references: [id])
  restaurant Restaurant @relation(fields: [restaurantId], references: [id])

  @@index([restaurantId])
  @@index([menuItemId])
  @@index([orderId])
  @@index([createdAt])
}

/// Kitchen Order Ticket — printing is mandatory, display screen is optional config
model KOT {
  id            Int       @id @default(autoincrement())
  kotNo         String
  status        KOTStatus @default(PENDING)
  notes         String?
  printCount    Int       @default(1)
  priority      Int       @default(0)
  cancelReason  String?
  lastPrintedAt DateTime?
  acceptedAt    DateTime?
  preparingAt   DateTime?
  readyAt       DateTime?
  servedAt      DateTime?
  cancelledAt   DateTime?
  orderId       Int
  restaurantId  Int
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  order      Order      @relation(fields: [orderId], references: [id])
  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  kotItems   KOTItem[]

  @@unique([restaurantId, kotNo])
  @@index([restaurantId])
  @@index([status])
  @@index([orderId])
  @@index([createdAt])
}

/// Junction: records which OrderItems (and quantities) were included in a specific KOT.
/// Enables incremental KOT printing — only the delta (quantity − sentQuantity) is recorded.
model KOTItem {
  id          Int      @id @default(autoincrement())
  kotId       Int
  orderItemId Int
  menuItemId  Int
  quantity    Int // the delta quantity included in this KOT
  price       Float // snapshot of item price at KOT creation time
  notes       String?
  createdAt   DateTime @default(now())

  kot       KOT       @relation(fields: [kotId], references: [id], onDelete: Cascade)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  menuItem  MenuItem  @relation(fields: [menuItemId], references: [id])

  @@index([kotId])
  @@index([orderItemId])
  @@index([kotId, orderItemId])
}

/// Bill / Invoice for an order
model Bill {
  id             Int            @id @default(autoincrement())
  billNo         String
  subtotal       Float
  taxAmount      Float
  discount       Float          @default(0)
  discountType   DiscountType?
  discountValue  Float          @default(0)
  discountReason String?
  discountedBy   Int?
  discountedAt   DateTime?
  serviceCharge  Float          @default(0)
  roundOff       Float          @default(0)
  grandTotal     Float
  paidAmount     Float          @default(0)
  balanceAmount  Float          @default(0)
  paymentMethod  PaymentMethod?
  status         BillStatus     @default(UNPAID)
  paymentStatus  PaymentStatus  @default(PENDING)
  printedAt      DateTime?
  reprintCount   Int            @default(0)
  cancelReason   String?
  cancelledAt    DateTime?
  cancelledBy    Int?
  isCancelled    Boolean        @default(false)
  refundedAt     DateTime?
  refundReason   String?
  orderId        Int            @unique
  restaurantId   Int
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  order      Order      @relation(fields: [orderId], references: [id])
  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  payments   Payment[]

  @@unique([restaurantId, billNo])
  @@index([restaurantId])
  @@index([status])
  @@index([paymentStatus])
  @@index([orderId])
  @@index([createdAt])
}

/// Individual payment transaction against a bill
model Payment {
  id               Int            @id @default(autoincrement())
  paymentNo        String
  amount           Float
  paymentMethod    PaymentMethod
  status           PaymentStatus  @default(PAID)
  gateway          PaymentGateway @default(NONE)
  transactionId    String?
  gatewayRef       String?
  failureReason    String?
  notes            String?
  createdBy        Int?
  refundedAt       DateTime?
  /// Card payment fields
  cardNumber       String?
  cardType         String?
  last4Digits      String?
  approvalCode     String?
  /// UPI payment fields
  upiTransactionId String?
  upiVerifiedAt    DateTime?
  billId           Int
  restaurantId     Int
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  bill       Bill       @relation(fields: [billId], references: [id])
  restaurant Restaurant @relation(fields: [restaurantId], references: [id])

  @@unique([restaurantId, paymentNo])
  @@index([restaurantId])
  @@index([billId])
  @@index([paymentMethod])
  @@index([status])
  @@index([gateway])
  @@index([createdAt])
}

/// Printer configuration per restaurant (1:1)
model PrinterSetting {
  id             Int            @id @default(autoincrement())
  printerName    String
  printerWidth   Int            @default(80)
  autoPrintBill  Boolean        @default(false)
  autoPrintKOT   Boolean        @default(false)
  showLogo       Boolean        @default(true)
  showGST        Boolean        @default(true)
  showQRCode     Boolean        @default(false)
  billHeader     String?
  billFooter     String?
  connectionType ConnectionType @default(USB)
  ipAddress      String?
  macAddress     String?
  port           Int?
  printersJson   String?        @default("[]") // JSON array of multiple printers
  restaurantId   Int            @unique
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])

  @@index([restaurantId])
}

/// Audit trail for compliance and security. Supports multi-tenant filtering by restaurantId.
model AuditLog {
  id           Int         @id @default(autoincrement())
  userId       Int?
  restaurantId Int?
  module       AuditModule
  action       AuditAction
  description  String
  referenceId  Int?
  referenceNo  String?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime    @default(now())

  restaurant Restaurant? @relation(fields: [restaurantId], references: [id])
  user       User?       @relation(fields: [userId], references: [id])

  @@index([restaurantId])
  @@index([userId])
  @@index([module])
  @@index([action])
  @@index([createdAt])
  @@index([referenceId])
}

/// Subscription plan for each restaurant (1:1). Limits/features are snapshotted from the Plan at assignment time.
model Subscription {
  id                Int                @id @default(autoincrement())
  restaurantId      Int                @unique
  planId            Int? // FK to Plan (database-driven plans; null for legacy rows)
  /// Downgrade scheduled by the restaurant admin — takes effect at the next renewal/expiry.
  scheduledPlanId   Int?
  plan              String             @default("TRIAL") // plan code (denormalized for display/filtering)
  status            SubscriptionStatus @default(TRIAL)
  businessMode      BusinessMode       @default(RESTAURANT) // snapshotted from Plan.businessMode at assignment time
  startDate         DateTime           @default(now())
  expiryDate        DateTime
  nextRenewalDate   DateTime?
  billingCycle      String             @default("MONTHLY") // MONTHLY | YEARLY | ONCE | TRIAL
  maxUsers          Int?
  maxTables         Int?
  maxFloors         Int?
  maxMenuItems      Int?
  maxPrinters       Int?
  maxBranches       Int?
  maxOrdersPerMonth Int?
  storageLimitMB    Int?
  features          Json? // JSON array of enabled feature keys (snapshot from Plan.features)
  amount            Float              @default(0)
  autoRenew         Boolean            @default(false)
  updatedBy         Int? // Super Admin user id who last changed this subscription
  cancelledAt       DateTime?
  cancelledReason   String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  restaurant           Restaurant            @relation(fields: [restaurantId], references: [id])
  planDef              Plan?                 @relation(fields: [planId], references: [id])
  scheduledPlan        Plan?                 @relation("ScheduledPlan", fields: [scheduledPlanId], references: [id])
  subscriptionPayments SubscriptionPayment[]

  @@index([restaurantId])
  @@index([planId])
  @@index([scheduledPlanId])
  @@index([plan])
  @@index([status])
  @@index([expiryDate])
}

/// Notifications for users within a restaurant
model Notification {
  id           Int                  @id @default(autoincrement())
  restaurantId Int
  userId       Int?
  title        String
  message      String
  type         NotificationType
  priority     NotificationPriority @default(NORMAL)
  deepLink     String?
  isRead       Boolean              @default(false)
  createdAt    DateTime             @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  user       User?      @relation(fields: [userId], references: [id])

  @@index([restaurantId])
  @@index([userId])
  @@index([type])
  @@index([isRead])
  @@index([createdAt])
  @@index([priority])
}

/// Global platform settings for Super Admin
model SystemSetting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Support tickets raised by restaurants
model SupportTicket {
  id           Int      @id @default(autoincrement())
  restaurantId Int
  userId       Int?
  subject      String
  description  String
  status       String   @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED, CLOSED
  priority     String   @default("NORMAL") // LOW, NORMAL, HIGH, URGENT
  assignedTo   Int?
  resolution   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  user       User?      @relation(fields: [userId], references: [id])
  assignee   User?      @relation("AssignedTickets", fields: [assignedTo], references: [id])

  @@index([restaurantId])
  @@index([status])
  @@index([priority])
  @@index([assignedTo])
}

/// Business documents uploaded during restaurant onboarding (GST, FSSAI, etc.)
model RestaurantDocument {
  id               Int            @id @default(autoincrement())
  restaurantId     Int
  documentType     String // e.g. GST_CERTIFICATE, FSSAI_LICENSE, BUSINESS_REGISTRATION, PAN, OWNER_ID, ADDRESS_PROOF, OTHER
  fileReference    String? // storage key / Cloudinary public_id
  originalFileName String?
  mimeType         String?
  fileSize         Int? // bytes
  status           DocumentStatus @default(PENDING)
  rejectionReason  String?
  uploadedBy       Int? // Super Admin user id
  uploadedAt       DateTime       @default(now())
  verifiedBy       Int? // Super Admin user id who verified/rejected
  verifiedAt       DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  uploader   User?      @relation(fields: [uploadedBy], references: [id])
  verifier   User?      @relation("VerifiedDocuments", fields: [verifiedBy], references: [id])

  @@index([restaurantId])
  @@index([status])
  @@index([documentType])
  @@index([createdAt])
}

/// Policy agreements accepted during restaurant onboarding (versioned)
model PolicyAgreement {
  id            Int      @id @default(autoincrement())
  restaurantId  Int
  policyType    String // e.g. TERMS_OF_SERVICE, PRIVACY_POLICY, SECURITY_POLICY, DATA_PROCESSING
  policyVersion String // e.g. "2026.01"
  acceptedBy    Int // Super Admin user id
  acceptedAt    DateTime @default(now())
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  accepter   User?      @relation("PolicyAccepters", fields: [acceptedBy], references: [id])

  @@index([restaurantId])
  @@index([policyType])
  @@index([acceptedBy])
  @@index([createdAt])
}

/// Subscription plan definition — fully database-driven (no hardcoded config).
/// Module access is stored relationally in PlanModulePermission.
model Plan {
  id                Int          @id @default(autoincrement())
  code              String       @unique // stable identifier, e.g. BASIC, PREMIUM
  name              String
  description       String?
  businessMode      BusinessMode @default(RESTAURANT) // POS experience: BASIC_POS or RESTAURANT
  monthlyPrice      Float        @default(0)
  yearlyPrice       Float        @default(0)
  billingCycle      BillingCycle @default(MONTHLY)
  trialDays         Int          @default(15)
  maxUsers          Int?
  maxTables         Int?
  maxFloors         Int?
  maxMenuItems      Int?
  maxPrinters       Int?
  maxBranches       Int?
  maxOrdersPerMonth Int?
  storageLimitMB    Int?
  features          Json         @default("[]") // Denormalized array of ENABLED module keys (kept in sync with PlanModulePermission)
  isActive          Boolean      @default(true)
  isDefault         Boolean      @default(false)
  sortOrder         Int          @default(0)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  subscriptions        Subscription[]
  scheduledOn          Subscription[]         @relation("ScheduledPlan")
  subscriptionPayments SubscriptionPayment[]
  modulePermissions    PlanModulePermission[]
  previousHistory      SubscriptionHistory[]  @relation("HistoryPreviousPlan")
  newHistory           SubscriptionHistory[]  @relation("HistoryNewPlan")

  @@index([isActive])
  @@index([code])
}

/// SaaS module catalog — every feature/module a plan can grant.
/// Fully database-driven: adding a row here surfaces a new ON/OFF toggle
/// in the plan editor without code changes.
model PlanModule {
  id          Int      @id @default(autoincrement())
  key         String   @unique // stable identifier, e.g. pos, kitchen, reports
  name        String
  description String?
  icon        String   @default("package") // icon hint consumed by the UI
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions PlanModulePermission[]

  @@index([isActive])
  @@index([key])
}

/// Plan ↔ module permission (relational). A plan grants/denies each catalog module.
/// This is the single source of truth for module access — no hardcoded plan config.
model PlanModulePermission {
  id        Int      @id @default(autoincrement())
  planId    Int
  moduleId  Int
  isEnabled Boolean  @default(true)
  createdAt DateTime @default(now())

  plan   Plan       @relation(fields: [planId], references: [id], onDelete: Cascade)
  module PlanModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([planId, moduleId])
  @@index([moduleId])
  @@index([planId])
}

/// Tracks a group of merged orders/tables. Each merge creates one MergeGroup.
/// When split or paid, status is set to SPLIT/COMPLETED.
model MergeGroup {
  id              Int       @id @default(autoincrement())
  restaurantId    Int
  primaryOrderId  Int
  status          String    @default("ACTIVE") // ACTIVE | SPLIT | COMPLETED
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  restaurant Restaurant    @relation(fields: [restaurantId], references: [id])
  primaryOrder Order       @relation(fields: [primaryOrderId], references: [id])
  tables       MergeGroupTable[]

  @@index([restaurantId])
  @@index([primaryOrderId])
  @@index([status])
}

/// Records which tables are part of a merge group.
model MergeGroupTable {
  id             Int      @id @default(autoincrement())
  mergeGroupId   Int
  tableId        Int
  originalOrderId Int     // the order that was on this table before the merge
  createdAt      DateTime @default(now())

  mergeGroup MergeGroup    @relation(fields: [mergeGroupId], references: [id], onDelete: Cascade)
  table      RestaurantTable @relation(fields: [tableId], references: [id])
  originalOrder Order       @relation(fields: [originalOrderId], references: [id])

  @@index([mergeGroupId])
  @@index([tableId])
  @@index([originalOrderId])
}

/// Online payment attempt for a subscription upgrade/renewal (Razorpay).
/// Every attempt is recorded first (CREATED), then marked PAID only after the
/// payment signature is verified server-side. Unique order/payment ids make
/// replays and duplicate webhook callbacks idempotent.
model SubscriptionPayment {
  id                Int       @id @default(autoincrement())
  restaurantId      Int
  subscriptionId    Int
  planId            Int?
  planCode          String
  planName          String?
  billingCycle      String    @default("MONTHLY") // MONTHLY | YEARLY | ONCE
  action            String    @default("UPGRADE") // UPGRADE | RENEWAL | SWITCH
  amount            Float
  status            String    @default("CREATED") // CREATED | PAID | FAILED | REFUNDED
  razorpayOrderId   String?   @unique
  razorpayPaymentId String?   @unique
  razorpaySignature String?
  paymentMethod     String? // from the gateway response (e.g. upi, card, netbanking)
  reference         String? // gateway reference / notes
  errorMessage      String?
  createdBy         Int?
  paidAt            DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  restaurant   Restaurant   @relation(fields: [restaurantId], references: [id])
  subscription Subscription @relation(fields: [subscriptionId], references: [id])
  plan         Plan?        @relation(fields: [planId], references: [id])

  @@index([restaurantId])
  @@index([subscriptionId])
  @@index([status])
  @@index([createdAt])
}

/// Platform-level email verification (onboarding OTP and future purposes).
/// Lives in the PUBLIC schema on purpose: email verification for onboarding
/// happens BEFORE any restaurant/tenant schema exists. Only a HASH of the OTP
/// is ever stored — never the plaintext code.
model EmailVerification {
  id         Int      @id @default(autoincrement())
  email      String // normalized (trim + lowercase)
  purpose    String   @default("ONBOARDING") // ONBOARDING | PASSWORD_RESET | EMAIL_CHANGE
  otpHash    String
  expiresAt  DateTime
  verifiedAt DateTime?
  attempts   Int      @default(0)
  lastSentAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([email, purpose])
  @@index([expiresAt])
  @@index([verifiedAt])
}

/// Durable email delivery log / queue. Every outbound email is recorded here
/// FIRST, then delivered through SMTP. Delivery failure never corrupts the
/// business transaction that triggered the email — failed rows are retried by
/// the email queue worker with bounded attempts. Idempotency keys prevent
/// duplicate sends (e.g. credential emails) across retries and cron runs.
model EmailLog {
  id             Int      @id @default(autoincrement())
  to             String
  template       String // EMAIL_VERIFICATION_OTP, APPLICATION_SUBMITTED_APPLICANT, ...
  subject        String
  payload        Json? // template variables (OTP/password live only until first successful send)
  status         String   @default("PENDING") // PENDING | SENDING | SENT | FAILED
  attempts       Int      @default(0)
  maxAttempts    Int      @default(3)
  lastError      String?
  idempotencyKey String?  @unique // dedup: one send per logical event
  sentAt         DateTime?
  failedAt       DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status])
  @@index([template])
  @@index([createdAt])
}

/// Append-only subscription history for every restaurant. Never overwritten.
model SubscriptionHistory {
  id             Int            @id @default(autoincrement())
  restaurantId   Int
  changeType     PlanChangeType
  previousPlanId Int?
  newPlanId      Int?
  previousPlan   String?
  newPlan        String?
  previousStatus String?
  newStatus      String?
  billingCycle   String?
  amount         Float?
  expiryDate     DateTime?
  changedBy      Int? // Super Admin user id
  notes          String?
  ipAddress      String?
  createdAt      DateTime       @default(now())

  restaurant      Restaurant @relation(fields: [restaurantId], references: [id])
  previousPlanDef Plan?      @relation("HistoryPreviousPlan", fields: [previousPlanId], references: [id])
  newPlanDef      Plan?      @relation("HistoryNewPlan", fields: [newPlanId], references: [id])

  @@index([restaurantId])
  @@index([changeType])
  @@index([createdAt])
}
